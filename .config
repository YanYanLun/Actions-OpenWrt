# ============================================================
# HiWiFi HC5761（64MB Flash 改造）— ImmortalWrt 23.05 配置
# 说明：本文件里每一条 CONFIG 后面都不允许写行尾注释，
#       kconfig 只认「整行以 # 开头」的注释，行尾注释会让该行被丢弃。
# ============================================================

# ---------- 目标平台 / 设备（固定，不要删） ----------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7620=y
CONFIG_TARGET_ramips_mt7620_DEVICE_hiwifi_hc5761=y

# ---------- 根文件系统 ----------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_TARGZ=y

# ---------- LuCI 中文界面 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# ---------- LuCI 主题 ----------
# Argon = 默认主题（iStoreOS 同款：蓝白卡片 + 左侧边栏）
# Material = 备用（青色顶栏那款），留着可随时切回去
# 切回 Material：uci set luci.main.mediaurlbase='/luci-static/material'
CONFIG_PACKAGE_luci-theme-material=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
# 主题壁纸走 HTTPS，显式锁 wget-ssl，避免被降级成 wget-nossl
CONFIG_PACKAGE_wget-ssl=y

# ---------- 服务类插件（照参考图补齐，均已核对存在于 23.05 源） ----------
# 动态 DNS（拉 ddns-scripts）
CONFIG_PACKAGE_luci-app-ddns=y
# 网络唤醒（拉 etherwake）
CONFIG_PACKAGE_luci-app-wol=y
# UPnP（拉 miniupnpd + rpcd-mod-ucode）
CONFIG_PACKAGE_luci-app-upnp=y
# KMS 服务器（拉 vlmcsd）
CONFIG_PACKAGE_luci-app-vlmcsd=y
# 迅雷快鸟（纯脚本，拉 jshn / wget-ssl / openssl-util）
CONFIG_PACKAGE_luci-app-xlnetacc=y

# ---------- 中文翻译 ----------
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-xlnetacc-zh-cn=y

# ---------- 参考图里默认不开的两项 ----------
# 1) 解锁网易云灰色歌曲 luci-app-unblockneteasemusic 在源里，但依赖 +node，
#    Node.js 在 MT7620A/128MB 上体积与性能都不合适，默认不开
# CONFIG_PACKAGE_luci-app-unblockneteasemusic=y
# 2) 上网时间控制：ImmortalWrt 的 luci 源里没有这个包，
#    只有 LEDE/coolsnowwolf 的 luci-app-accesscontrol 才有，需第三方源，默认不做

# 广告屏蔽大师 Plus+（luci-app-adbyby-plus）已主动移除：
# 其规则服务器停更，且会强制把 dnsmasq 换成 dnsmasq-full。
# 需要广告拦截时用下面 adblock-fast 或 AdGuardHome，它们不换 dnsmasq。

# ---------- 网页终端 / 常用工具 ----------
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y

# ---------- USB 存储（HC5761 带 USB 口，64M 空间充裕；不需要可整段删掉） ----------
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_block-mount=y

# ---------- 以下为可选插件，默认不开，需要时取消下面那一行的 # ----------
# 广告/DNS 过滤（现代方案，不动 dnsmasq）
# CONFIG_PACKAGE_luci-app-adblock-fast=y
# CONFIG_PACKAGE_luci-app-adguardhome=y
# 科学上网（需先在 diy-part1.sh 里打开 helloworld / passwall 源）
# CONFIG_PACKAGE_luci-app-passwall=y
# CONFIG_PACKAGE_luci-app-openclash=y
# 网络共享 / 下载
# CONFIG_PACKAGE_luci-app-samba4=y
# CONFIG_PACKAGE_luci-app-aria2=y
# CONFIG_PACKAGE_luci-app-transmission=y
