# ============================================================
# HiWiFi HC5761（32MB Flash 改造）— ImmortalWrt 23.05 最小骨架配置
# 打印：make defconfig 会自动补全其余默认项，本文件只需要保证关键项在
# ============================================================

# ---------- 目标平台 / 设备（固定，不要删） ----------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7620=y
CONFIG_TARGET_ramips_mt7620_DEVICE_hiwifi_hc5761=y

# ---------- 根文件系统 ----------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_TARGZ=y

# ---------- LuCI 中文界面 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# ---------- 网页终端 / 常用工具 ----------
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y

# ---------- USB 存储（HC5761 带 USB 口，32M 空间够用；不需要可注释） ----------
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_block-mount=y

# ---------- 以下为可选插件，默认不开，需要时自行取消注释 ----------
# 科学上网（需要先在 diy-part1.sh 里打开 helloworld / passwall 源）
# CONFIG_PACKAGE_luci-app-passwall=y
# 网络共享 / 下载
# CONFIG_PACKAGE_luci-app-samba4=y
# CONFIG_PACKAGE_luci-app-aria2=y
# 旁路由 / DNS
# CONFIG_PACKAGE_luci-app-adguardhome=y
