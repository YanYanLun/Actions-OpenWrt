#!/bin/sh
# 设定 LuCI 默认主题：Argon（iStoreOS 同款，蓝白卡片 + 左侧边栏），
# 没有就退回 Material（青色顶栏那款），再没有就保持系统默认 bootstrap。
# 运行时换主题（不用重编）：uci set luci.main.mediaurlbase='/luci-static/material'

theme=''
[ -d /www/luci-static/argon ] && theme='/luci-static/argon'
[ -z "$theme" ] && [ -d /www/luci-static/material ] && theme='/luci-static/material'
[ -z "$theme" ] && exit 0

uci -q get luci.main >/dev/null || exit 0

uci -q batch <<-EOF
	set luci.main.mediaurlbase='$theme'
	commit luci
EOF

exit 0
