		"read": {
			"file": {
				"/proc/stat": [
					"read"
				],
				"/proc/meminfo": [
					"read"
				],
				"/proc/net/dev": [
					"read"
				],
				"/proc/uptime": [
					"read"
				],
				"/proc/loadavg": [
					"read"
				],
				"/proc/mtd": [
					"read"
				],
				"/proc/version": [
					"read"
				],
				"/proc/cpuinfo": [
					"read"
				],
				"/sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq": [
					"read"
				],
