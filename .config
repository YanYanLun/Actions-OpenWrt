# ============================================================
# HiWiFi HC5761（32MB Flash 改造）— ImmortalWrt 23.05 最小骨架配置
# 打印：make defconfig 会自动补全其余默认项，本文件只需要保证关键项在
# ============================================================

# ---------- 目标平台 / 设备（固定，不要删） ----------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7620=y
CONFIG_TARGET_ramips_mt7620_DEVICE_hiwifi_hc5761=y

# ---------- 根文件系统 ----------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_TARGZ=y

# ---------- LuCI 中文界面 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# ---------- LuCI 主题 ----------
# Argon：默认主题（由 files/etc/uci-defaults/99-luci-theme 切过去）
# Material：就是参考图里那款（青色顶栏 + 深色抽屉），装上但不设默认，
#           想用就 SSH 执行：uci set luci.main.mediaurlbase='/luci-static/material'
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-theme-material=y
# 主题的壁纸列表要用 HTTPS 拉，显式拉上 wget-ssl（默认也走它，写死避免被降级成 wget-nossl）
CONFIG_PACKAGE_wget-ssl=y

# ---------- 服务类插件（照参考图补齐，均已核对在 23.05 源里） ----------
CONFIG_PACKAGE_luci-app-ddns=y              # 动态 DNS（拉 ddns-scripts）
CONFIG_PACKAGE_luci-app-wol=y               # 网络唤醒（拉 etherwake）
CONFIG_PACKAGE_luci-app-upnp=y              # UPnP（拉 miniupnpd + rpcd-mod-ucode）
CONFIG_PACKAGE_luci-app-vlmcsd=y            # KMS 服务器（拉 vlmcsd）
CONFIG_PACKAGE_luci-app-xlnetacc=y          # 迅雷快鸟（纯脚本，拉 jshn/wget-ssl/openssl-util）
# 广告屏蔽大师 Plus+：依赖 +adbyby +ipset +dnsmasq-full +dos2unix +uclient-fetch
# 注意：它要求 dnsmasq-full，必须把默认的 dnsmasq 顶掉，否则两个包冲突
CONFIG_PACKAGE_luci-app-adbyby-plus=y
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
# 中文翻译
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-adbyby-plus-zh-cn=y
CONFIG_PACKAGE_luci-i18n-xlnetacc-zh-cn=y

# ---------- 参考图里装不了的两个 ----------
# 1) 解锁网易云灰色歌曲：luci-app-unblockneteasemusic 在源里，但依赖 +node
#    （Node.js 在 MT7620A/128MB 上体积和性能都不合适），默认不开
# CONFIG_PACKAGE_luci-app-unblockneteasemusic=y
# 2) 上网时间控制：ImmortalWrt 的 luci 源里没有（只有 LEDE/coolsnowwolf 的
#    luci-app-accesscontrol 才有），要装得先加第三方源，风险高，默认不做

# ---------- 网页终端 / 常用工具 ----------
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y

# ---------- USB 存储（HC5761 带 USB 口，32M 空间够用；不需要可注释） ----------
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_block-mount=y

# ---------- 以下为可选插件，默认不开，需要时自行取消注释 ----------
# 科学上网（需要先在 diy-part1.sh 里打开 helloworld / passwall 源）
# CONFIG_PACKAGE_luci-app-passwall=y
# CONFIG_PACKAGE_luci-app-openclash=y
# 网络共享 / 下载
# CONFIG_PACKAGE_luci-app-samba4=y
# CONFIG_PACKAGE_luci-app-aria2=y
# CONFIG_PACKAGE_luci-app-transmission=y
# 旁路由 / DNS
# CONFIG_PACKAGE_luci-app-adguardhome=y
# 广告拦截（比 adbyby 更现代，规则走 AdGuard/uBO 列表）
# CONFIG_PACKAGE_luci-app-adblock-fast=y
